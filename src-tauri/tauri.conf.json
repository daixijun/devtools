{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devtools",
  "version": "0.1.0",
  "identifier": "devtools.linuxyunwei.com",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1453",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "开发者工具箱",
        "width": 680,
        "height": 68,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
